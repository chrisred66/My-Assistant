# Copy to .env and fill in. .env is git-ignored - keep real values in your password manager.

APP_ENV=development            # development | production
APP_DEBUG=true                 # show error details in responses (false in production)
APP_TIMEZONE=UTC               # e.g. Asia/Shanghai, Asia/Dubai

# MySQL / MariaDB (XAMPP). Use a dedicated user, not root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chrismanager_dev       # use chrismanager on the always-on desktop
DB_USER=chrismanager
DB_PASS=

# Login tokens issued to each device
TOKEN_TTL_DAYS=90

# Where uploaded audio is stored (relative to server/)
STORAGE_PATH=storage/recordings
MAX_UPLOAD_MB=25

# --- AI providers (keys live only on the server) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=             # set a current chat model id from platform.openai.com/docs/models
OPENAI_TRANSCRIBE_MODEL=whisper-1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Default provider for /ai/translate: anthropic | openai | deepseek
TRANSLATE_PROVIDER=anthropic

# Optional admin keys for pulling official usage reports (later phase)
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=
