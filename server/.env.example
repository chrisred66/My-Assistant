# Copy to .env and fill in. .env is git-ignored - keep real values in your password manager.

APP_ENV=development            # development | production
APP_DEBUG=true                 # show error details in responses (false in production)
APP_TIMEZONE=system            # "system" follows Windows; or an IANA name like Asia/Dubai

# MySQL / MariaDB (XAMPP). Use a dedicated user, not root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chrismanager_dev       # use chrismanager on the always-on desktop
DB_USER=chrismanager
DB_PASS=

# Login tokens issued to each device
TOKEN_TTL_DAYS=90

# Where uploaded audio is stored (relative to server/)
STORAGE_PATH=storage/recordings
MAX_UPLOAD_MB=25

# --- AI providers (keys live only on the server) ---
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=        # only for keys not scoped to a workspace (wrkspc_...)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=             # set a current chat model id from platform.openai.com/docs/models
                                # (also learns and applies transcript habits for non-Chinese transcripts)
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize   # meetings: transcription with speaker labels

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Default provider for /ai/translate: anthropic | openai | deepseek
TRANSLATE_PROVIDER=deepseek    # translation: deepseek (cheapest), or anthropic for Claude
LIGHT_PROVIDER=deepseek       # light tasks, e.g. language detection (DeepSeek). Transcription always uses OpenAI

# Optional admin keys for pulling official usage reports (later phase)
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=

# PT Management (GBA toolkit) database. User and password default to DB_USER / DB_PASS.
GBA_DB_NAME=gba_database
GBA_DB_USER=
GBA_DB_PASS=
PT_CURRENCY=AED               # shown with maintenance costs

# Behind Cloudflare Tunnel or another proxy: the header holding the visitor's real IP (sign-in lockout, activity log).
# TRUSTED_PROXY_HEADER=CF-Connecting-IP
