{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "My Assistant",
    "version": "0.4.1",
    "identifier": "com.chris.chrismanager",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "My Assistant",
                "width": 1200,
                "height": 800,
                "minWidth": 720,
                "minHeight": 520,
                "label": "main",
                "additionalBrowserArgs": "--lang=en-GB --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
                "create": false
            },
            {
                "label": "ball",
                "title": "Usage",
                "url": "index.html#ball",
                "width": 128,
                "height": 138,
                "resizable": false,
                "maximizable": false,
                "minimizable": false,
                "decorations": false,
                "transparent": true,
                "shadow": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "focus": false,
                "additionalBrowserArgs": "--lang=en-GB --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
                "create": false
            },
            {
                "label": "pet",
                "title": "Pet",
                "url": "index.html#pet",
                "width": 490,
                "height": 330,
                "resizable": false,
                "maximizable": false,
                "minimizable": false,
                "decorations": false,
                "transparent": true,
                "shadow": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "focus": false,
                "additionalBrowserArgs": "--lang=en-GB --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
                "create": false
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/pet-pack/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMzQ5RkVGNjJGN0E4MDEKUldRQnFQZGk3NTgwekp4SkJhWmcvci9rUmpLNkZUNy83c1UrZWxqV1ZaV3c2RWV0YVpaQklyemIK",
            "endpoints": [
                "https://github.com/chrisred66/My-Assistant/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
